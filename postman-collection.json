        {
          "name": "List Active Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/events",
              "host": ["{{base_url}}"],
              "path": ["events"]
            }
          }
        },
        {
          "name": "Register Event 1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": {{event_id_1}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/events/register",
              "host": ["{{base_url}}"],
              "path": ["events", "register"]
            }
          }
        },
        {
          "name": "Register Event 2",
          "request": {

CONTROL_AUTH_USERNAME=graphics
CONTROL_AUTH_PASSWORD=change-me
DEDUPE_TTL_MS=30000
MIN_FETCH_INTERVAL_MS=1500
FETCH_MAX_RETRIES=3
FETCH_RETRY_BASE_MS=750
